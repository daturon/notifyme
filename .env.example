# Postgres connection string (e.g. Supabase or Neon)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Resend API key for sending email notifications (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret used to authorize calls to the Vercel Cron endpoint
CRON_SECRET=changeme

# Password protecting access to the single-user app
APP_PASSWORD=changeme
